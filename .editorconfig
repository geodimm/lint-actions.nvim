root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# Fixtures are captured tool output and the exact files that output describes.
# Normalising them on save moves the positions the tests assert against.
[tests/fixtures/**]
indent_style = unset
insert_final_newline = false
trim_trailing_whitespace = false
